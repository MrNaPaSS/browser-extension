{
  "manifest_version": 3,
  "name": "NMNH Trading Robot",
  "version": "2.1.3",
  "description": "Enterprise AI-powered trading assistant for PocketOption. Real-time signals, strategy management & risk analytics.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.pocketoption.com/*",
        "*://*.po.trade/*",
        "*://*.po.cash/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["tv-widget.html"],
      "matches": ["*://*.pocketoption.com/*", "*://*.po.trade/*", "*://*.po.cash/*"]
    }
  ],
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' https://s3.tradingview.com"
  }
}
